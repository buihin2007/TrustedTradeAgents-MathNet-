    {
      "id": 7,
      "type": "table",
      "title": "Đơn hàng: ai duyệt, bao nhiêu tiền, mất bao lâu",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tta-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tta-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select created_at as \"Lúc tạo\", status as \"Trạng thái\", agent_name as \"Agent\", amount_eur as \"EUR\", array_to_string(reasons, ', ') as \"Lý do\", option_count as \"Phương án\", decided_by::text as \"Người duyệt\", seconds_to_decision as \"Giây tới khi duyệt\", trace_id as \"Trace\" from wholesaler.v_audit_orders where $__timeFilter(created_at) and ('${intent}' = '' or intent_id::text = '${intent}') order by created_at desc limit 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trạng thái"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "allow": {
                        "color": "blue",
                        "index": 0
                      },
                      "ask_human": {
                        "color": "orange",
                        "index": 1
                      },
                      "block": {
                        "color": "red",
                        "index": 2
                      },
                      "placed": {
                        "color": "blue",
                        "index": 3
                      },
                      "held": {
                        "color": "orange",
                        "index": 4
                      },
                      "blocked": {
                        "color": "red",
                        "index": 5
                      },
                      "rejected": {
                        "color": "purple",
                        "index": 6
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trace"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Mở trace trong Langfuse",
                    "url": "${langfuse_project_url}/traces/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "EUR"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              }
            ]
          }
        ]
      }

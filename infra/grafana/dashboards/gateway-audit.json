  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "EUR đặt tự động hoặc đã duyệt",
      "description": "Tổng tiền các đơn placed trong khoảng thời gian đang chọn.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tta-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tta-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select coalesce(sum(amount_eur), 0) as eur from wholesaler.v_audit_orders where status = 'placed' and $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Đơn đang chờ người duyệt",

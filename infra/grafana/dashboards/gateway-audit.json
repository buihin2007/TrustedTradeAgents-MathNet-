      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tta-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select r as reason, count(*) as calls from wholesaler.v_audit_gateway, unnest(reasons) as r where $__timeFilter(ts) group by 1 order by 2 desc limit 10"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "reason",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      }

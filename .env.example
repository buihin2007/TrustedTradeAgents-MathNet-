# Copy to .env and fill in. Never commit .env. Check everything with: python scripts/check_env.py

# --- Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PROJECT_REF=
# Connect -> Session pooler (port 5432). Password: letters and digits only.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- OpenRouter
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_MODEL_SQL=deepseek/deepseek-v4.1-flash
LLM_MODEL_FALLBACK=anthropic/claude-haiku-5.5
# 1024 dims, must match wholesaler.products.embedding
EMBED_MODEL=baai/bge-m3
# optional: a faster model for the buyer agent's two LLM calls (understand, recipes); empty = LLM_MODEL
LLM_FAST_MODEL=
# used when the model above fails or times out
LLM_FALLBACK_MODEL=anthropic/claude-haiku-5.5
JEV_MODEL=~typesafe/jev-latest
# 1 = also judge each gateway tool call with Jev (off: Jev only screens the buyer's first message)
GATEWAY_JEV=0

# --- Valio Aimo mock API (key: challenge PDF page 5)
VALIO_API_BASE=https://junction26.valioaimo.fi
VALIO_API_KEY=
VALIO_CUSTOMER=123

# --- Agent
# 16+ chars; its sha256 is stored in wholesaler.agents.key_hash
# must start with tta_ (the gateway treats any other Bearer token as a user JWT -> FORBIDDEN)
AGENT_KEY=
MCP_URL=http://nginx/mcp

# --- Langfuse (OTLP settings are derived in tta_contracts.telemetry)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# optional: makes trace ids in the web audit page clickable, e.g. https://cloud.langfuse.com/project/<id>
NEXT_PUBLIC_LANGFUSE_PROJECT_URL=
# 0 = traces keep timings only: no buyer text, prompts, model output or tool arguments
TRACE_CONTENT=1

# --- Grafana (Valio Aimo audit dashboard)
# host part of DATABASE_URL
GRAFANA_DB_HOST=
# letters and digits; set in Supabase: alter role dashboard_ro with login password '<this>';
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# 0 = batch catalog search uses full text only (faster, less tolerant of wording)
SEARCH_BATCH_VECTORS=1
